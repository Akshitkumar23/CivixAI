# CivixAI Production & Development Configuration Template
# Copy this file to .env and supply actual values for your deployment.

# AI Gateway (Optional: Set when AI_EXPLANATIONS_ENABLED=true)
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Backend & Frontend Service URLs
NEXT_PUBLIC_ML_API_URL=http://127.0.0.1:8000
ML_API_URL=http://127.0.0.1:8000

# Database Configuration (Defaults to SQLite; set for PostgreSQL production)
# DATABASE_URL=postgresql://user:password@localhost:5432/civix_db

# Security & Secrets
CIVIX_ADMIN_TOKEN=generate-a-secure-random-token
PII_ENCRYPTION_KEY=32-character-base64-or-hex-encryption-key-for-aes-gcm

# Feature Flags (All Default to false for strict compliance)
AUTH_ACCOUNTS_ENABLED=false
AI_EXPLANATIONS_ENABLED=false
MCP_SERVER_ENABLED=true
MCP_WRITE_ENABLED=false
DIGILOCKER_ENABLED=false
API_SETU_ENABLED=false
PRIVATE_LOANS_ENABLED=false
PRIVATE_INSURANCE_COMPARISON_ENABLED=false
LTR_ENABLED=false
VOICE_ENABLED=false

# Object Storage & Task Worker (Optional: Set for S3/MinIO & Redis)
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_BUCKET_NAME=civix-snapshots
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# REDIS_URL=redis://localhost:6379/0

# Observability & Monitoring
# SENTRY_DSN=
